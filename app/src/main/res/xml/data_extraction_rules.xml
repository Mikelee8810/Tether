<?xml version="1.0" encoding="utf-8"?>
<!--
  The Room database (relationship_radar.db) holds reviewed call-insight excerpts and
  relationship data. It is excluded from cloud Auto Backup and device-to-device transfer
  until an encrypted backup story exists; nothing else is backed up from the database domain.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="relationship_radar.db" />
        <exclude domain="database" path="relationship_radar.db-shm" />
        <exclude domain="database" path="relationship_radar.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="relationship_radar.db" />
        <exclude domain="database" path="relationship_radar.db-shm" />
        <exclude domain="database" path="relationship_radar.db-wal" />
    </device-transfer>
</data-extraction-rules>
